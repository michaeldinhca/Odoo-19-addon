<?xml version="1.0"?>
<odoo>
	<record id="bi_pos_inherit_product_template_warranty_renewal" model="ir.ui.view">
        <field name="name">bi.pos.inherit.product.template.warranty.renewal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="bi_warranty_registration.bi_inherit_product_template_warranty_renewal"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
        	<xpath expr="//form/sheet/notebook/page[3]" position="inside">
        		<group>
        			<field name="is_extended_warranty"/>
                    <field name="extended_warranty_ids" invisible= 'not is_extended_warranty'>
                        <list string="Extended Warranty" editable="bottom">
                            <field name="extended_warranty_period"/>
                            <field name="extended_warranty_percentage"/>
                            <field name="extended_warranty_amount"/>
                            <field name="product_id" invisible="1"/>
                        </list>
                    </field>
        		</group>
        	</xpath>
        </field>	
    </record>


    <record id="bi_pos_warranty_details_form_view" model="ir.ui.view">
        <field name="name">bi.pos.warranty.details.form.view</field>
        <field name="model">product.warranty</field>
        <field name="inherit_id" ref="bi_warranty_registration.warranty_details_form_view"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
        	<xpath expr="//notebook" position="inside">
        		<page string='Extended Warranty History'>
                    <field name="extended_warranty_history_ids" readonly="state != 'new'" >
                        <list string="Extended Warranty History" editable="bottom">
                            <field name="is_extended_warranty" invisible="1"/>
                            <field name="ex_warranty_start_date"/>
                            <field name="ex_warranty_end_date"/>
                            <field name="extended_warranty_period"/>
                            <field name="extended_warranty_percentage"/>
                            <field name="extended_warranty_amount"/>
                            <field name="warranty_id" invisible="1"/>
                        </list>
                    </field>
                </page>

                <page string='Extended Claim Claims'>
                    <field name="extended_warranty_claim_ids" readonly="state != 'new'">
                        <list string="Extended Claim History" readonly='1'>
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="serial_no"/>
                            <field name="stage_id"/>
                            <field name="warranty" invisible="1"/>
                        </list>
                    </field>
                </page>
        	</xpath>
        </field>	
    </record>
</odoo>