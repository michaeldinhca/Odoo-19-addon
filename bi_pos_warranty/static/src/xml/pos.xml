<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
	<t t-name="SelectLotPopup" t-inherit="point_of_sale.SelectLotPopup" t-inherit-mode="extension" owl="1">
		<xpath expr="//div[hasclass('lot-container')]" position="inside"><br/>
			<t t-if="props.extended_warranty_period">
				<select class="extended_warranty_selector" id="extended_warranty_selector" name="extended_warranty_selector">
	                <option value="None">Select Extended Warranty Period</option>
	                <t t-foreach="props.extended_warranty_period" t-as="extend_id" t-key="extend_id.id">
	                	<option t-att-value="extend_id.id">
	                        <t t-esc="extend_id.extended_warranty_period" />
	                    </option>
	                </t>
	            </select>
	        </t>
		</xpath> 
	</t>

	<t t-name="Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" owl="1">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
        	<t t-if="line.extended_warranty_line">
	            <li class="info">
	                <span class="">
	                    <b>
	                    	Extended Warranty 
	                       (<t t-esc="line.extended_warranty_line"/>)  
	                    </b>
	                </span>
	            </li>
	        </t>
        </xpath>
    </t>

    <t t-name="bi_pos_warranty.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
        	<t t-log = "props.order"/>
        	<t t-if="props.order.lines[0].warranty_period">
        		<div>
					Warranty : (<t t-esc="props.order.lines[0].warranty_period"/> Months )
        		</div>
        	</t>
        </xpath>
    </t>

  
</templates>