<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- picking form view -->
		<record id="bi_view_move_picking_tree_inherit_serial_number" model="ir.ui.view">
			<field name="name">bi.view.move.picking.list.inherit.serial.number</field>
			<field name="model">stock.picking</field>
			<field name="inherit_id" ref="stock.view_picking_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
					<field name="serial_no" options="{'no_create': True}"/>
				</xpath>
			</field>
		</record>

	</data>
</odoo>