<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Single shared injection point: web.external_layout is the dispatcher
        every report calls before picking a layout variant (standard, boxed,
        bold, striped, folder, wave, bubble). Resolving the fiscal position
        here - after o/company are normalized, before the variant is chosen -
        makes it available to whichever variant renders next, since QWeb
        t-call shares the rendering scope (same mechanism core uses for
        forced_vat).
    -->
    <template id="external_layout_provincial_tax_id" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='company.external_report_layout_id']" position="before">
            <t t-set="provincial_fiscal_position" t-value="env['account.fiscal.position']._get_document_provincial_fiscal_position(o)"/>
        </xpath>
    </template>

    <!--
        Each variant repeats the same VAT <li t-if="not forced_vat">/<li
        t-else=""> pair. We target the "else" li by its forced_vat span
        (there's an unrelated t-else="" li earlier in each template, for the
        company-details block) and insert our line right after it, so it
        always renders immediately below whichever GST/HST line actually
        shows. The fiscal position's own name is printed alongside "Tax ID"
        (e.g. "Manitoba Tax ID: 163809-7") so it's clear which registration
        this is, rather than a generic "Provincial Tax ID" label.
    -->
    <template id="external_layout_standard_provincial_tax_id" inherit_id="web.external_layout_standard">
        <xpath expr="//li[@t-else='' and .//span[@t-esc='forced_vat']]" position="after">
            <li t-if="provincial_fiscal_position"><t t-esc="provincial_fiscal_position.name">Manitoba</t> Tax ID: <span t-esc="provincial_fiscal_position.provincial_tax_id">163809-7</span></li>
        </xpath>
    </template>

    <template id="external_layout_boxed_provincial_tax_id" inherit_id="web.external_layout_boxed">
        <xpath expr="//li[@t-else='' and .//span[@t-esc='forced_vat']]" position="after">
            <li t-if="provincial_fiscal_position"><t t-esc="provincial_fiscal_position.name">Manitoba</t> Tax ID: <span t-esc="provincial_fiscal_position.provincial_tax_id">163809-7</span></li>
        </xpath>
    </template>

    <template id="external_layout_bold_provincial_tax_id" inherit_id="web.external_layout_bold">
        <xpath expr="//li[@t-else='' and .//span[@t-esc='forced_vat']]" position="after">
            <li t-if="provincial_fiscal_position"><t t-esc="provincial_fiscal_position.name">Manitoba</t> Tax ID: <span t-esc="provincial_fiscal_position.provincial_tax_id">163809-7</span></li>
        </xpath>
    </template>

    <template id="external_layout_striped_provincial_tax_id" inherit_id="web.external_layout_striped">
