<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_form_inherit_theme" model="ir.ui.view">
        <field name="name">survey.survey.form.inherit.theme</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='questions_layout']" position="after">
                <field name="theme_style" widget="radio"/>
            </xpath>
        </field>
    </record>
</odoo>
