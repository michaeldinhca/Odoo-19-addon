<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="warranty_template_list_view" model="ir.ui.view">
            <field name="name">warranty.template.list.view</field>
            <field name="model">warranty.template</field>
            <field name="arch" type="xml">
                <list string="Warranty Template">
                    <field name="template_name"/>
                    <field name="warranty_template"/>
                </list>
            </field>
        </record>


        <record id="warranty_template_form_view" model="ir.ui.view">
            <field name="name">warranty.template.form.view</field>
            <field name="model">warranty.template</field>
            <field name="arch" type="xml">
                <form string="Warranty Template Details">
                    <sheet>
                        <group>
                            <field name="template_name"/>
                        </group>
                        <div>
                            <field name="warranty_template" nolabel="True"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>