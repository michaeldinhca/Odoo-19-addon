<?xml version="1.0"?>
<odoo>
    <data>
        <record id="purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//page/field[@name='order_line']/list/field[@name='name']" position="after">
                    <field name="serial_no"  options="{'no_create': True}"/>
                </xpath>
                <xpath expr="//button[@name='action_view_invoice']" position="after">
                    <button type="object" name="button_warranty" class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="warranty_sale == 0">
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field name="warranty_sale"  widget='statinfo' nolabel="1"/>
                                <span class="o_stat_text">Warranty</span>
                            </span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
  </data>
     <template id="purchase_inherit_report" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="//th[@name='th_description']" position="after">
                <th>Serial No.</th>
            </xpath>
            <xpath expr="//table[hasclass('o_has_total_table')]/tbody/t[2]/tr/t[1]/td[1]" position="after">
                <td><span t-field="line.serial_no"/></td>
            </xpath>
        </template>
</odoo>