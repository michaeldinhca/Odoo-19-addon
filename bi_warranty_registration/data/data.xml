<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="warranty_serial_no" model="ir.sequence">
        <field name="name">Warranty Serial No</field>
        <field name="code">warranty.serial</field>
        <field name="prefix">Receipt/</field>
        <field name="padding">5</field>
    </record>

    <record id="certificate_serial_no" model="ir.sequence">
        <field name="name">Certificate No</field>
        <field name="code">warranty.certificate</field>
        <field name="prefix">Certificate/</field>
        <field name="padding">5</field>
    </record>

    <record id="ir_cron_scheduler_warranty_expire" model="ir.cron">
        <field name="name">Warranty Expire</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_product_warranty"/>
        <field name="state">code</field>
        <field name="code">model.warranty_expiry_scheduler_queue()</field>
        <field name="priority" eval="5"/>
    </record>

    <record id="ir_cron_scheduler_renew" model="ir.cron">
        <field name="name">Renew Notification</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_product_warranty"/>
        <field name="state">code</field>
        <field name="code">model.warranty_renew_scheduler()</field>
        <field name="priority" eval="5"/>
    </record>

    <record id="standerd_warranty_template_format" model="warranty.template">
        <field name="template_name">Default Template</field>
        <field name="warranty_template" type="html">
            <p>Thank You,</p>
            <p>
               Mr/Ms. certificate_partner_id For Choosing certificate_product_id as Your Trusted Vapor Barrier for your<br/>
               crawl space moisture control.
            </p>
            <p>
                The Vapor Barrier used in your home can be identified by following Serial Number warrenty_lot_id
            </p>
            <p>
                It was Inspected and packaged on certificate_mang_date Greenwood,South Carolina.
            </p>
            <p>
                This Vapor barrier qualifies for our 30 years Warranty.It was Lab Tested for VOC's and Passed. The<br/>
                lab result report attached.
            </p>
            <p>
                Your Vapor Barrier was manufactured with the highest standard bu our manufacturing Team at our<br/>
                _____________ Facility.
            </p>
        </field>
    </record>

</odoo>

