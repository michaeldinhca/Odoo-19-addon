<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_remittance" model="mail.template">
            <field name="name">Payment: Remittance Advice</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="subject">{{ object.company_id.name }} Remittance Advice (Payment {{ object.name or 'n/a' }})</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to the vendor with the remittance slip (PDF) attached</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <t t-set="registration" t-value="object.remittance_registration_id"/>
    <p style="margin: 0px 0px 12px 0px;">
        Dear <t t-out="object.partner_id.name or ''">Vendor</t>,
    </p>
    <p style="margin: 0px 0px 12px 0px;">
        <t t-if="object.payment_type == 'inbound'">
            This is the remittance advice for payment <strong t-out="object.name or ''">PBNK1/2026/00001</strong>
            dated <t t-out="format_date(object.date)">2026-01-31</t>.
            After applying your credits against your bills, <t t-out="object.company_id.name or ''">YourCompany</t>
            received a net amount of <strong t-out="format_amount(object.amount, object.currency_id) or ''">$ 723.87</strong> from you.
        </t>
        <t t-else="">
            This is the remittance advice for payment <strong t-out="object.name or ''">PBNK1/2026/00001</strong>
            dated <t t-out="format_date(object.date)">2026-01-31</t>.
            <t t-out="object.company_id.name or ''">YourCompany</t> has issued a net payment of
            <strong t-out="format_amount(object.amount, object.currency_id) or ''">$ 89.75</strong> to you.
        </t>
    </p>
    <t t-if="registration and registration.allocation_ids">
        <table style="border-collapse: collapse; width: 100%; margin: 0px 0px 12px 0px; font-size: 12px;">
            <thead>
                <tr style="background-color: #f2f2f2;">
                    <th align="left" style="padding: 6px; border-bottom: 1px solid #999999;">Bill / Credit</th>
                    <th align="left" style="padding: 6px; border-bottom: 1px solid #999999;">Date</th>
                    <th align="right" style="padding: 6px; border-bottom: 1px solid #999999;">Original Amount</th>
                    <th align="right" style="padding: 6px; border-bottom: 1px solid #999999;">Due Before Payment</th>
                    <th align="right" style="padding: 6px; border-bottom: 1px solid #999999;">Amount Applied</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="registration.allocation_ids" t-as="line">
                    <td style="padding: 5px 6px; border-bottom: 1px solid #e5e5e5;">
                        <t t-out="line.display_reference or ''">BILL/2026/0001</t>
                        <t t-if="line.document_type == 'credit'"> (credit)</t>
                    </td>
                    <td style="padding: 5px 6px; border-bottom: 1px solid #e5e5e5;"><t t-out="format_date(line.document_date) if line.document_date else ''">2026-01-15</t></td>
                    <td align="right" style="padding: 5px 6px; border-bottom: 1px solid #e5e5e5;"><t t-out="format_amount(line.original_amount, line.currency_id)">$ 100.00</t></td>
                    <td align="right" style="padding: 5px 6px; border-bottom: 1px solid #e5e5e5;"><t t-out="format_amount(line.amount_due_before, line.currency_id)">$ 100.00</t></td>
                    <td align="right" style="padding: 5px 6px; border-bottom: 1px solid #e5e5e5;"><t t-out="format_amount(line.amount_applied, line.currency_id)">$ 100.00</t></td>
                </tr>
            </tbody>
        </table>
        <p style="margin: 0px 0px 12px 0px;">Credits are shown as negative amounts. The attached remittance slip gives the full detail.</p>
    </t>
    <t t-else="">
        <p style="margin: 0px 0px 12px 0px;">The attached remittance slip lists the documents settled by this payment.</p>
    </t>
    <p style="margin: 0px 0px 12px 0px;">Do not hesitate to contact us if you have any questions.</p>
    <t t-set="signature" t-value="user.signature or ''"/>
    <t t-if="not is_html_empty(signature)">
        <p t-if="'regards' not in signature.lower()" style="margin: 0px 0px 8px 0px;">Best regards,</p>
        <div t-out="signature">Mitchell Admin</div>
    </t>
    <t t-else="">
        <p style="margin: 0px;">Best regards,<br/><t t-out="object.company_id.name or ''">YourCompany</t></p>
    </t>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('enterprise_remittance_management.action_report_remittance_slip'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
