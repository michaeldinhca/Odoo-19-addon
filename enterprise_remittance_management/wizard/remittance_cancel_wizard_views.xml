<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="remittance_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">enterprise.remittance.cancel.wizard.form</field>
        <field name="model">enterprise.remittance.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Payment Bill/Credit Offsets">
                <field name="operation" invisible="1"/>
                <field name="can_reverse" invisible="1"/>
                <field name="eligible_count" invisible="1"/>
                <field name="blocked_count" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <p class="mb-1">
                        The bills and credits below were settled together. Registering the payment offset them
                        against each other. Cancelling or deleting the payment does <strong>not</strong> undo
                        those offsets by itself.
                    </p>
                    <p class="mb-0">
                        Keeping them is the safe default. Only offsets created by this registration that are still
                        safe to reverse can be reversed, and only with your explicit choice.
                    </p>
                </div>

                <separator string="Payment"/>
                <field name="registration_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="name"/>
                        <field name="partner_id" string="Vendor"/>
                        <field name="payment_date"/>
                        <field name="payment_type"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="net_amount" string="Net Payment"/>
                        <field name="state"/>
                    </list>
                </field>

                <separator string="Source Bills and Credits"/>
                <field name="allocation_ids" nolabel="1">
                    <list create="0" delete="0" edit="0" decoration-info="document_type == 'credit'">
                        <field name="display_reference" string="Bill/Credit Reference"/>
                        <field name="document_type"/>
                        <field name="document_date"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="amount_due_before"/>
                        <field name="payment_applied"/>
                        <field name="offset_applied"/>
                    </list>
                </field>

                <separator string="Reconciliation Links (bill/credit offsets)"/>
                <field name="offsets_html" nolabel="1"/>

                <separator string="Decision"/>
                <group>
                    <field name="outcome" widget="radio" invisible="operation == 'offsets_only'"/>
                    <field name="reason" placeholder="Why is this being done? It is recorded for audit."/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="can_reverse or (outcome != 'reverse' and operation != 'offsets_only')">
                    <field name="reverse_blocker" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
