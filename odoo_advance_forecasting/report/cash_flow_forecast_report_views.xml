<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cash_flow_forecast_report_list" model="ir.ui.view">
        <field name="name">cash.flow.forecast.report.list</field>
        <field name="model">cash.flow.forecast.report</field>
        <field name="arch" type="xml">
            <list string="Cash Flow Forecast" create="0" edit="0" delete="0"
                  decoration-danger="is_overdue">
                <field name="bucket_date"/>
                <field name="source_type"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="amount_in" sum="Incoming"/>
                <field name="amount_out" sum="Outgoing"/>
                <field name="net_amount" sum="Net"/>
                <field name="running_balance"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_cash_flow_forecast_report_pivot" model="ir.ui.view">
        <field name="name">cash.flow.forecast.report.pivot</field>
        <field name="model">cash.flow.forecast.report</field>
        <field name="arch" type="xml">
            <pivot string="Cash Flow Forecast" disable_linking="True">
                <field name="bucket_date" type="row" interval="month"/>
                <field name="source_type" type="row"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
                <field name="net_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_cash_flow_forecast_report_graph" model="ir.ui.view">
        <field name="name">cash.flow.forecast.report.graph</field>
        <field name="model">cash.flow.forecast.report</field>
        <field name="arch" type="xml">
            <graph string="Cash Flow Forecast" type="line">
                <field name="bucket_date" type="row"/>
                <field name="running_balance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_cash_flow_forecast_report_search" model="ir.ui.view">
        <field name="name">cash.flow.forecast.report.search</field>
        <field name="model">cash.flow.forecast.report</field>
        <field name="arch" type="xml">
            <search string="Cash Flow Forecast">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="Next 30 Days" name="next_30_days"
                        domain="[('bucket_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="Next 60 Days" name="next_60_days"
                        domain="[('bucket_date', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <filter string="Next 90 Days" name="next_90_days"
                        domain="[('bucket_date', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Incoming" name="incoming" domain="[('direction', '=', 'in')]"/>
                <filter string="Outgoing" name="outgoing" domain="[('direction', '=', 'out')]"/>
                <group>
                    <filter string="Source" name="group_source_type" context="{'group_by': 'source_type'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Forecast Date" name="group_bucket_date" context="{'group_by': 'bucket_date:month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cash_flow_forecast_report" model="ir.actions.act_window">
        <field name="name">Cash Flow Forecast</field>
        <field name="res_model">cash.flow.forecast.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_cash_flow_forecast_report_search"/>
        <field name="context">{'search_default_next_90_days': 1}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_empty_folder">
            No forecasted cash movements
          </p><p>
            This report projects your cash balance forward using only confirmed
            documents: posted unpaid invoices/bills and confirmed sale/purchase
            orders not yet fully invoiced or billed.
          </p>
        </field>
    </record>

    <menuitem id="menu_action_cash_flow_forecast_report"
              name="Cash Flow Forecast"
              action="action_cash_flow_forecast_report"
              parent="account.account_reports_management_menu"
              sequence="25"/>

</odoo>
