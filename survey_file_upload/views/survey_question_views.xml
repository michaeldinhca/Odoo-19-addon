<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_question_form_inherit_file_upload" model="ir.ui.view">
        <field name="name">survey.question.form.inherit.file.upload</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <!-- Preview panel: same pattern as the stock per-type preview blocks -->
            <xpath expr="//div[hasclass('o_preview_questions')]" position="inside">
                <div invisible="question_type != 'file_upload'">
                    <span>Attach your file</span><br/>
                    <i class="fa fa-cloud-upload fa-4x" role="img" aria-label="File upload" title="File upload"/>
                </div>
            </xpath>
            <!-- Options tab: max size / multiple toggle, alongside the other per-type answer options -->
            <xpath expr="//field[@name='comment_count_as_answer']" position="after">
                <field name="file_upload_max_size_mb" invisible="question_type != 'file_upload'"/>
                <field name="file_upload_multiple" invisible="question_type != 'file_upload'"/>
            </xpath>
        </field>
    </record>
</odoo>
