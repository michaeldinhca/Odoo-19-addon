<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ngyn_gantt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ngyn.gantt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="calendar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='calendar']" position="inside">
                <setting id="ngyn_gantt_groupby_setting"
                         string="Calendar Timeline"
                         help="Choose what the read-only weekly Timeline view (under Calendar) groups rows by.">
                    <field name="x_ngyn_gantt_groupby_field"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
