<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ngyn_calendar_gantt.Timeline" owl="1">
        <WithSearch t-if="state.searchViewId" t-props="withSearchProps" t-slot-scope="search">
            <Layout display="{controlPanel: {}}">
                <t t-set-slot="layout-actions">
                    <SearchBar/>
                </t>
                <NgynGanttBody domain="search.domain" groupBy="search.groupBy" context="search.context"/>
            </Layout>
        </WithSearch>
    </t>

    <t t-name="ngyn_calendar_gantt.Body" owl="1">
        <div class="o_ngyn_gantt">
            <div class="o_ngyn_gantt_header">
                <div class="o_ngyn_gantt_nav">
                    <button class="btn btn-secondary" t-on-click="prevWeek" title="Previous week">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <button class="btn btn-secondary" t-on-click="today">Today</button>
                    <button class="btn btn-secondary" t-on-click="nextWeek" title="Next week">
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <span class="o_ngyn_gantt_range" t-esc="weekRangeLabel"/>
                    <span class="o_ngyn_gantt_tz" t-if="timezoneLabel" t-esc="timezoneLabel"/>
                    <button class="btn btn-primary ms-auto" t-on-click="createEvent">
                        <i class="fa fa-plus"/> New
                    </button>
                </div>
            </div>

            <div class="o_ngyn_gantt_grid">
                <div class="o_ngyn_gantt_row o_ngyn_gantt_row_head">
                    <div class="o_ngyn_gantt_row_label"/>
                    <div class="o_ngyn_gantt_days">
                        <t t-foreach="dayHeaders" t-as="day" t-key="day.iso">
                            <div t-attf-class="o_ngyn_gantt_day_col{{ day.isToday ? ' o_today' : '' }}">
                                <div class="o_ngyn_gantt_day_label" t-esc="day.label"/>
                                <div class="o_ngyn_gantt_hour_ruler">
                                    <t t-foreach="hourTicks" t-as="tick" t-key="tick.hour">
                                        <span t-attf-style="left:{{tick.leftPct}}%" t-esc="tick.label"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <t t-if="state.loading">
                    <div class="o_ngyn_gantt_empty">Loading…</div>
                </t>
                <t t-elif="!state.rows.length">
                    <div class="o_ngyn_gantt_empty">No events match.</div>
                </t>

                <t t-foreach="state.rows" t-as="row" t-key="row.key">
                    <div class="o_ngyn_gantt_row">
                        <div class="o_ngyn_gantt_row_label">
                            <i t-if="showCrmIcon(row)" class="fa fa-external-link o_ngyn_gantt_row_icon"
                               title="Open opportunity" t-on-click="() => this.openOpportunity(row)"/>
                            <span t-esc="row.label"/>
                        </div>
                        <div class="o_ngyn_gantt_days o_ngyn_gantt_track" t-att-style="rowHeight(row)">
                            <t t-foreach="[0,1,2,3,4,5,6]" t-as="col" t-key="col">
                                <div class="o_ngyn_gantt_gridline"/>
                            </t>
                            <t t-foreach="row.lanes" t-as="lane" t-key="lane_index">
                                <t t-foreach="lane" t-as="ev" t-key="ev.id">
                                    <div class="o_ngyn_gantt_bar"
                                         t-att-style="barStyle(ev)"
                                         t-att-title="barTitle(ev)"
                                         t-on-click="() => this.openEvent(ev)">
                                        <div class="o_ngyn_gantt_handle o_ngyn_gantt_handle_start"
                                             t-on-mousedown="(mouseEvent) => this.onResizeStart(mouseEvent, ev, 'start')"/>
                                        <div class="o_ngyn_gantt_bar_label">
                                            <t t-if="state.activeGroupbyField === 'opportunity_id' and ev.attendees.length">
                                                <span class="o_ngyn_gantt_avatars">
                                                    <t t-foreach="ev.attendees.slice(0, 2)" t-as="attendee" t-key="attendee.id">
                                                        <span class="o_ngyn_gantt_avatar"
                                                              t-attf-style="background-color:{{avatarColor(attendee.id)}}"
                                                              t-esc="initials(attendee.name)"/>
                                                    </t>
                                                    <span class="o_ngyn_gantt_avatar_more" t-if="ev.attendees.length > 2"
                                                          t-esc="'+' + (ev.attendees.length - 2)"/>
                                                </span>
                                            </t>
                                            <span t-esc="ev.name"/>
                                        </div>
                                        <t t-if="resizingEventId() === ev.id">
                                            <span class="o_ngyn_gantt_resize_badge" t-att-style="resizeBadgeStyle()" t-esc="resizeLabel"/>
                                        </t>
                                        <div class="o_ngyn_gantt_handle o_ngyn_gantt_handle_stop"
                                             t-on-mousedown="(mouseEvent) => this.onResizeStart(mouseEvent, ev, 'stop')"/>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
