<odoo noupdate="1">
    <record id="mail_template_late_fee_notice" model="mail.template">
        <field name="name">Late Fee Notice</field>
        <field name="model_id" ref="model_account_late_fee"/>
        <field name="subject">Late Fee Applied — Invoice {{ object.move_id.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email or '') }}</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p>Dear <t t-out="object.partner_id.name"/>,</p>
    <p>
        A late fee has been applied related to invoice
        <t t-out="object.move_id.name"/>. Full details below:
    </p>
    <div style="white-space: pre-line; border-left: 3px solid #875A7B; padding: 8px 12px; margin: 12px 0; background-color: #f8f8f8;">
        <t t-out="object.description"/>
    </div>
    <p>
        If you have already made this payment or believe this fee was
        applied in error, please contact us and we will be happy to
        assist.
    </p>
    <p>
        Thank you,<br/>
        <t t-out="object.company_id.name"/>
    </p>
</div>
]]>
        </field>
    </record>
</odoo>
