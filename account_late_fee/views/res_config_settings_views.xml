<odoo>
    <record id="res_config_settings_view_form_late_fee" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.late.fee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="late_fee_settings" string="Late Fees"
                         help="Automate late payment fees on overdue customer invoices">
                    <field name="late_fee_enabled"/>
                    <div class="content-group" invisible="not late_fee_enabled">
                        <div class="row mt16">
                            <label for="late_fee_notification_email" class="col-lg-5 o_light_label"/>
                            <field name="late_fee_notification_email" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <button name="%(account_late_fee.action_late_fee_model)d"
                                    icon="oi-arrow-right" type="action"
                                    string="Configure Late Fee Models" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
