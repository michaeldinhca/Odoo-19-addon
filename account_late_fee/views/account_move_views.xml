<odoo>
    <record id="view_move_form_late_fee" model="ir.ui.view">
        <field name="name">account.move.form.late.fee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_late_fees"
                        class="oe_stat_button" icon="fa-clock-o"
                        invisible="late_fee_count == 0">
                    <field name="late_fee_count" widget="statinfo" string="Late Fees"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="late_fee_model_id" invisible="move_type != 'out_invoice'"/>
                <field name="late_fee_exempt" invisible="move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="late_fee_status" widget="badge"
                       decoration-info="late_fee_status == 'pending'"
                       decoration-success="late_fee_status == 'applied'"
                       invisible="move_type != 'out_invoice' or late_fee_status == 'none'"/>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page string="Late Fees" name="late_fees" invisible="late_fee_count == 0">
                    <field name="late_fee_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="due_date"/>
                            <field name="period_index"/>
                            <field name="period_date"/>
                            <field name="overdue_days"/>
                            <field name="fee_amount"/>
                            <field name="state" widget="badge"/>
                            <field name="fee_move_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
