<odoo>
    <record id="view_late_fee_model_list" model="ir.ui.view">
        <field name="name">late.fee.model.list</field>
        <field name="model">late.fee.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="computation_type"/>
                <field name="percentage" optional="show"/>
                <field name="fixed_amount" optional="show"/>
                <field name="interval_type"/>
                <field name="recurrence"/>
                <field name="application_mode"/>
                <field name="is_company_default" widget="boolean_toggle"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_late_fee_model_form" model="ir.ui.view">
        <field name="name">late.fee.model.form</field>
        <field name="model">late.fee.model</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_default" type="object"
                            string="Set as Company Default"
                            invisible="is_company_default"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Default"
                            invisible="not is_company_default"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard 1.5%/month"/></h1>
                    </div>
                    <group>
                        <group string="Company">
                            <field name="company_id"/>
                            <field name="is_company_default"/>
                            <field name="active"/>
                        </group>
                        <group string="Fee Calculation">
                            <field name="computation_type"/>
                            <field name="percentage"
                                   invisible="computation_type != 'percentage'"
                                   required="computation_type == 'percentage'"/>
                            <field name="fixed_amount"
                                   invisible="computation_type != 'fixed'"
                                   required="computation_type == 'fixed'"/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="grace_period_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="Recurrence">
                            <field name="recurrence"/>
                            <field name="max_occurrences"
                                   invisible="recurrence != 'recurring'"/>
                        </group>
                        <group string="Application">
                            <field name="application_mode"/>
                            <field name="late_fee_product_id"/>
                            <field name="late_fee_journal_id"/>
                            <field name="send_notification_email"/>
                            <field name="mail_template_id"
                                   invisible="not send_notification_email"
                                   placeholder="Default template"/>
                            <button name="action_edit_mail_template" type="object"
                                    string="Edit Email Template" icon="fa-pencil"
                                    invisible="not send_notification_email"
                                    class="btn-link"/>
                        </group>
                    </group>
                    <group>
                        <field name="additional_note"
                               placeholder="Optional text appended to every fee description generated by this model..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_late_fee_model" model="ir.actions.act_window">
        <field name="name">Late Fee Models</field>
        <field name="res_model">late.fee.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">
                Create your first Late Fee Model
            </p>
            <p>
                Define how late fees are calculated: percentage or fixed
                amount, per day/week/month, one-time or recurring.
            </p>
        </field>
    </record>
</odoo>
