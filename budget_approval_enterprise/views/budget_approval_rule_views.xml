<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_approval_rule_list" model="ir.ui.view">
        <field name="name">budget.approval.rule.list</field>
        <field name="model">budget.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="budget_type"/>
                <field name="min_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_budget_approval_rule_form" model="ir.ui.view">
        <field name="name">budget.approval.rule.form</field>
        <field name="model">budget.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Budgets above 50,000"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="budget_type"/>
                            <field name="min_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        When several rules match a budget, only the first one by sequence is used.
                        Steps run in order. Each step is assigned to one or more job positions: the employees of the budget's company holding one of them, except the requester, are the approvers. "Approvals Needed" sets how many of them must approve (any one, all, or at least N). One rejection always rejects the step.
                    </p>
                    <field name="step_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="e.g. Finance review"/>
                            <field name="job_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="approval_mode"/>
                            <field name="required_count" invisible="approval_mode != 'count'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_approval_rule_search" model="ir.ui.view">
        <field name="name">budget.approval.rule.search</field>
        <field name="model">budget.approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_budget_approval_rule" model="ir.actions.act_window">
        <field name="name">Budget Approval Rules</field>
        <field name="res_model">budget.approval.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
