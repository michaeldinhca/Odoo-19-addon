<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

         <record id="refresh_qbo_access_token_cron" model="ir.cron" forcecreate="True">
           <field name="name">QuickBooks Online: Refresh Access Token (Technical)</field>
           <field name="interval_number">56</field>
           <field name="interval_type">minutes</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
           <field name="state">code</field>
           <field name="code">model.refresh_qbo_access_token()</field>
         </record>

        <record id="trigget_send_invoices_to_qb_cron" model="ir.cron" forcecreate="True">
           <field name="name">QuickBooks Online: Export Invoices (Odoo → QuickBooks)</field>
           <field name="interval_number">5</field>
           <field name="interval_type">minutes</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
           <field name="state">code</field>
           <field name="code">model.export_invoices_to_quickbooks_cron()</field>
         </record>

        <record id="trigget_receive_qb_payments_cron" model="ir.cron" forcecreate="True">
           <field name="name">QuickBooks Online: Import Payments (QuickBooks → Odoo)</field>
           <field name="interval_number">12</field>
           <field name="interval_type">minutes</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
           <field name="state">code</field>
           <field name="code">model.import_quickbooks_payments_cron()</field>
         </record>

        <record id="trigger_export_quickbooks_payments_cron" model="ir.cron" forcecreate="True">
           <field name="name">QuickBooks Online: Export Payments (Odoo → QuickBooks)</field>
           <field name="interval_number">9</field>
           <field name="interval_type">minutes</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
           <field name="state">code</field>
           <field name="code">model.export_payments_to_quickbooks_cron()</field>
         </record>

        <record id="trigger_send_updates_to_qb_cron" model="ir.cron" forcecreate="True">
           <field name="name">QuickBooks Online: Synchronize Data (Odoo → QuickBooks)</field>
           <field name="interval_number">14</field>
           <field name="interval_type">minutes</field>
           <field name="active" eval="True"/>
           <field name="user_id" ref="base.user_root"/>
           <field name="model_id" ref="quickbooks_sync_online.model_quickbooks_integration"/>
           <field name="state">code</field>
           <field name="code">model.update_records_to_quickbooks_cron()</field>
         </record>

    </data>
</odoo>