<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quickbooks_partner_type_wizard_form_view" model="ir.ui.view">
        <field name="name">quickbooks.partner.type.wizard.form.view</field>
        <field name="model">quickbooks.partner.type.wizard</field>
        <field name="arch" type="xml">
            <form string="QuickBooks Partner Options">
                <sheet>
                    <group>
                        <field name="qbo_partner_type" required="1" widget="radio"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Export" name="export_to_quickbooks"
                            type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
