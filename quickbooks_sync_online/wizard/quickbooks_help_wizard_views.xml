<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quickbooks_help_wizard_info_form_view" model="ir.ui.view">
        <field name="name">quickbooks.help.wizard.info.form.view</field>
        <field name="model">quickbooks.help.wizard</field>
        <field name="arch" type="xml">
            <form string="Summary Info">
                <sheet>
                    <div colspan="2">
                        <field name="information" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
