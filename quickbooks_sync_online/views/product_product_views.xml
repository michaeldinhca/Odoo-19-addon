<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page name="quickbooks_online" string="QuickBooks Online">
                    <group>
                        <field name="is_qbo_taxable" widget="boolean_toggle"/>
                        <field name="qbo_mapping_ids">
                            <list>
                                <field name="qbo_id"/>
                                <field name="qbo_name"/>
                                <field name="quickbooks_integration_id"/>
                            </list>
                        </field>
                        <field name="is_qbo_update_required" widget="boolean_toggle"/>
                    </group>
                    <group groups="base.group_no_one">
                        <div colspan="2">
                            <button type="object"
                                    name="to_qbo_json"
                                    class="btn btn-outline-primary"
                                    string="DISPLAY EXPORT JSON: debug"
                            />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[last()]" position="after">
                <notebook>
                    <page name="quickbooks_online" string="QuickBooks Online">
                        <group>
                            <field name="qbo_mapping_ids">
                                <list>
                                    <field name="qbo_id"/>
                                    <field name="qbo_name"/>
                                    <field name="quickbooks_integration_id"/>
                                </list>
                            </field>
                            <field name="is_qbo_taxable" widget="boolean_toggle"/>
                            <field name="is_qbo_update_required" widget="boolean_toggle"/>
                        </group>
                        <group groups="base.group_no_one">
                            <div colspan="2">
                                <button type="object"
                                        name="to_qbo_json"
                                        class="btn btn-outline-primary"
                                        string="DISPLAY EXPORT JSON: debug"
                                />
                            </div>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_product_export_to_quickbooks_server" model="ir.actions.server">
        <field name="name">Export to QuickBooks</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="code">
action = records.action_export_to_quickbooks()
        </field>
    </record>

</odoo>
