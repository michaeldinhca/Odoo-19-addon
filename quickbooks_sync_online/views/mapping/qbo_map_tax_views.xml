<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_tax_tree" model="ir.ui.view">
        <field name="model">qbo.map.tax</field>
        <field name="name">qbo.map.tax.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="tax_id" domain="[('company_id', '=', company_id), ('type_tax_use', '=', 'sale')]"/>
                <field name="type_tax_use" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_tax_form" model="ir.ui.view">
        <field name="model">qbo.map.tax</field>
        <field name="name">qbo.map.tax.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="tax_id"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_tax_search" model="ir.ui.view">
        <field name="model">qbo.map.tax</field>
        <field name="name">qbo.map.tax.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_name"/>
                <field name="tax_id"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('tax_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_tax" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="path">qi-taxes</field>
        <field name="res_model">qbo.map.tax</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_tax_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

</odoo>
