<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_taxcode_tree" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">qbo.map.taxcode.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sales_tax_rate_ids" readonly="1" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
                <field name="purchase_tax_rate_ids" readonly="1" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_taxcode_form" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">qbo.map.taxcode.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sales_tax_rate_ids"
                       widget="many2many_tags"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                />
                <field name="purchase_tax_rate_ids"
                       widget="many2many_tags"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_taxcode_search" model="ir.ui.view">
        <field name="model">qbo.map.taxcode</field>
        <field name="name">qbo.map.taxcode.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_name"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_taxcode" model="ir.actions.act_window">
        <field name="name">Taxcodes</field>
        <field name="path">qi-taxcodes</field>
        <field name="res_model">qbo.map.taxcode</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_taxcode_tree"/>
    </record>

</odoo>
