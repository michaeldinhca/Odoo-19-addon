<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_product_tree" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">qbo.map.product.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="stock_keeping_unit"/>
                <field name="variant_options" optional="hide"/>
                <field name="product_id"/>
                <button
                    name="refresh_qbo_mapping_body"
                    type="object"
                    string="Refresh from QuickBooks"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_product_form" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">qbo.map.product.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="replace"/>

            <xpath expr="//field[@name='qbo_id']" position="after">
                <field name="qbo_name" readonly="1"/>
                <field name="stock_keeping_unit" readonly="1"/>
                <field name="variant_options" readonly="1"/>
                <field name="product_id" force_save="1"
                       readonly="category_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="category_id" force_save="1"
                       readonly="product_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="product_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_product_search" model="ir.ui.view">
        <field name="model">qbo.map.product</field>
        <field name="name">qbo.map.product.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="stock_keeping_unit"/>
                <field name="product_id"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('product_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="path">qi-products</field>
        <field name="res_model">qbo.map.product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_product_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

    <record id="action_qbo_map_product_try_map" model="ir.actions.server">
        <field name="name">Map by SKU/Name (Create if Missing)</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_product"/>
        <field name="code">
action = records.try_to_map()
        </field>
    </record>

</odoo>
