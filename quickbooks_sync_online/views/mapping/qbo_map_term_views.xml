<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_term_tree" model="ir.ui.view">
        <field name="model">qbo.map.term</field>
        <field name="name">qbo.map.term.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="term_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_term_form" model="ir.ui.view">
        <field name="model">qbo.map.term</field>
        <field name="name">qbo.map.term.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="term_id"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_term_search" model="ir.ui.view">
        <field name="model">qbo.map.term</field>
        <field name="name">qbo.map.term.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_name"/>
                <field name="term_id"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('term_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_term" model="ir.actions.act_window">
        <field name="name">Terms</field>
        <field name="path">qi-payment-terms</field>
        <field name="res_model">qbo.map.term</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_term_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

</odoo>
