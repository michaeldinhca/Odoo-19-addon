<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_payment_method_tree" model="ir.ui.view">
        <field name="model">qbo.map.payment.method</field>
        <field name="name">qbo.map.payment.method.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">sequence</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_id']" position="before">
                <field name="sequence" widget="handle"/>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="journal_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_payment_method_form" model="ir.ui.view">
        <field name="model">qbo.map.payment.method</field>
        <field name="name">qbo.map.payment.method.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="journal_id"
                       domain="[('company_id', '=', company_id), ('type', 'in', ('bank', 'cash'))]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="method_type" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_payment_method_search" model="ir.ui.view">
        <field name="model">qbo.map.payment.method</field>
        <field name="name">qbo.map.payment.method.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="journal_id"/>
                <field name="method_type"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('journal_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="path">qi-payment-methods</field>
        <field name="res_model">qbo.map.payment.method</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_payment_method_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

</odoo>
