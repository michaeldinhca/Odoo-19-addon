<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_payment_tree" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">qbo.map.payment.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="sync_token" readonly="1" optional="hide"/>
                <field name="payment_id"/>
                <field name="invoice_id" optional="hide"/>
                <field name="txn_amount"/>
                <field name="currency_ref" readonly="1"/>
                <button
                    name="register_payment_in_odoo"
                    type="object"
                    string="Register Payment"
                    invisible="payment_id"
                />
                <button
                    name="refresh_qbo_mapping_body"
                    type="object"
                    string="Refresh from QuickBooks"
                    groups="base.group_no_one"
                />
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_payment_form" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">qbo.map.payment.form</field>
        <field name="type">form</field>
        <field type="xml" name="arch">
            <form string="Payment" create="false" edit="false">
                <group>
                    <field name="qbo_id"/>
                    <field name="qbo_name"/>
                    <field name="txn_id"/>
                    <field name="invoice_id" groups="base.group_no_one"/>
                    <field name="payment_id"/>
                    <field name="txn_type"/>
                    <field name="txn_amount"/>
                    <field name="currency_ref"/>
                    <field name="pay_method"/>
                    <field name="txn_date"/>
                    <field name="sync_token" readonly="1"/>
                    <field name="company_id"/>
                    <field name="qbo_object"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_qbo_map_payment_search" model="ir.ui.view">
        <field name="model">qbo.map.payment</field>
        <field name="name">qbo.map.payment.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="payment_id"/>
                <field name="invoice_id"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('payment_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="path">qi-payments</field>
        <field name="res_model">qbo.map.payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_payment_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

</odoo>
