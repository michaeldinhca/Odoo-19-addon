<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_sale_order_tree" model="ir.ui.view">
        <field name="model">qbo.map.sale.order</field>
        <field name="name">qbo.map.sale.order.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="total_tax"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_sale_order_form" model="ir.ui.view">
        <field name="model">qbo.map.sale.order</field>
        <field name="name">qbo.map.sale.order.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_name']" position="after">
                <field name="order_id"
                       domain="[('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="qbo_lib_type"/>
                <field name="partner_id"/>
                <field name="qbo_tax_ids" readonly="1" widget="many2many_tags"/>
                <field name="total_tax" readonly="1"/>
                <field name="order_map_line_ids" readonly="1">
                    <list>
                        <field name="line_num"/>
                        <field name="item_map_id"/>
                        <field name="tax_class"/>
                        <field name="tax_code"/>
                        <field name="tax_map_ids" widget="many2many_tags"/>
                    </list>
                </field>
                <div colspan="2" class="d-flex gap-2">
                    <button name="apply_taxes_from_intuit"
                            string="Apply QuickBooks Taxes"
                            type="object"
                            invisible="not order_id"/>
                    <button name="delete_qbo_one_with_delay"
                            string="Delete on QuickBooks"
                            type="object"
                            invisible="not order_id"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_sale_order_search" model="ir.ui.view">
        <field name="model">qbo.map.sale.order</field>
        <field name="name">qbo.map.sale.order.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="total_tax"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('order_id', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_sale_order" model="ir.actions.act_window">
        <field name="name">Sale Receipts</field>
        <field name="path">qi-sale-orders</field>
        <field name="res_model">qbo.map.sale.order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_sale_order_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

    <record id="action_qbo_map_sale_order_delete_in_qbo" model="ir.actions.server">
        <field name="name">Delete in QuickBooks</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="quickbooks_sync_online.model_qbo_map_sale_order"/>
        <field name="binding_model_id" ref="quickbooks_sync_online.model_qbo_map_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(6, 0, (ref('base.group_no_one'),))]"/>
        <field name="code">
record.action_delete_in_qbo()
        </field>
    </record>

</odoo>
