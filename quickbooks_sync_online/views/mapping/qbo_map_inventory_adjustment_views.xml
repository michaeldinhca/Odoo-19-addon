<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_inventory_adjustment_tree" model="ir.ui.view">
        <field name="model">qbo.map.inventory.adjustment</field>
        <field name="name">qbo.map.inventory.adjustment.list</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_tree"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_id']" position="after">
                <field name="doc_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_inventory_adjustment_form" model="ir.ui.view">
        <field name="model">qbo.map.inventory.adjustment</field>
        <field name="name">qbo.map.inventory.adjustment.form</field>
        <field name="inherit_id" ref="quickbooks_sync_online.view_qbo_map_model_form"/>
        <field name="mode">primary</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='qbo_id']" position="after">
                <field name="doc_number"/>
            </xpath>
        </field>
    </record>

    <record id="view_qbo_map_inventory_adjustment_search" model="ir.ui.view">
        <field name="model">qbo.map.inventory.adjustment</field>
        <field name="name">qbo.map.inventory.adjustment.search</field>
        <field name="arch" type="xml">
            <search>
                <field name="qbo_id"/>
                <field name="doc_number"/>
                <filter string="Not Mapped" name="not_mapped" domain="[('doc_number', '=', False)]"/>

                <!-- Group by -->
                <group>
                    <filter string="Connection" name="group_quickbooks_integration_id" context="{'group_by': 'quickbooks_integration_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_data_qbo_map_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field>
        <field name="path">qi-inventory-adjustments</field>
        <field name="res_model">qbo.map.inventory.adjustment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_qbo_map_inventory_adjustment_tree"/>
        <field name="context">
            {
                'search_default_not_mapped': 1,
            }
        </field>
    </record>

</odoo>
