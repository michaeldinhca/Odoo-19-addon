<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_qbo_map_model_tree" model="ir.ui.view">
        <field name="model">qbo.map.abstract</field>
        <field name="name">qbo.map.abstract.list</field>
        <field name="type">list</field>
        <field type="xml" name="arch">
            <list create="false" editable="bottom">
                <field name="id" groups="base.group_no_one" optional="hide"/>
                <field name="quickbooks_integration_id" readonly="1"/>
                <field name="company_id" readonly="1" optional="hide"/>
                <field name="qbo_id"/>
                <field name="qbo_name"/>
                <field name="qbo_lib_type" optional="hide"/>
                <button type="object" name="open_formview" string="OPEN"/>
            </list>
        </field>
    </record>

    <record id="view_qbo_map_model_form" model="ir.ui.view">
        <field name="model">qbo.map.abstract</field>
        <field name="name">qbo.map.abstract.form</field>
        <field name="type">form</field>
        <field type="xml" name="arch">
            <form create="false">
                <group>
                    <field name="qbo_id"/>
                    <field name="qbo_name"/>
                    <field name="quickbooks_integration_id" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="qbo_object" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

</odoo>
