<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position='inside'>
                <span class="d-inline-flex">
                    <field name="is_qbo_sync_done" invisible="1"/> <!-- For the next span visibility -->
                    <span class="o_form_label2 ms-3" invisible="not is_qbo_sync_done">
                        <span class="badge rounded-pill" style="color: #2B9E1B !important; border: 1px solid #2B9E1B; background-color: #EEF9EC;">
                            <i class="fa fa-fw fa-check-circle-o pe-2"></i>Synced with QuickBooks
                        </span>
                    </span>
                </span>
            </div>
            <xpath expr="//notebook/page[last()]" position="after">
                <field name="is_product_variant" invisible="1"/> <!-- Required because it is used in the fields domains in the model -->
                <page name="quickbooks_online" string="QuickBooks Online" invisible="product_variant_count > 1 or is_product_variant">
                    <group>
                        <field name="qbo_mapping_ids">
                            <list>
                                <field name="qbo_id"/>
                                <field name="qbo_name"/>
                                <field name="quickbooks_integration_id"/>
                            </list>
                        </field>
                        <field name="is_qbo_taxable" widget="boolean_toggle"/>
                        <field name="is_qbo_update_required" widget="boolean_toggle"/>
                    </group>
                    <group groups="base.group_no_one" invisible="product_variant_count != 1">
                        <div colspan="2">
                            <button type="object"
                                    name="to_qbo_json"
                                    class="btn btn-outline-primary"
                                    string="DISPLAY EXPORT JSON: debug"
                            />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_product_template_export_to_quickbooks_server" model="ir.actions.server">
        <field name="name">Export to QuickBooks</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="code">
action = records.action_export_to_quickbooks()
        </field>
    </record>

</odoo>
