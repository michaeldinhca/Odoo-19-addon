<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_quickbooks_online" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.quickbooks.online</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="QuickBooks Online" string="QuickBooks Online" name="quickbooks_sync_online" groups="quickbooks_sync_online.qbo_security_group_manager">
                    <div id="information">
                        <h2>Information</h2>
                        <div class="row mt16 o_settings_container" name="information_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <div class="o_form_label mb-1">Get up and running</div>
                                    <div class="text-muted mb-2">
                                        Check configuration documentation to get the connector ready.
                                    </div>
                                    <a href="https://ventortech.atlassian.net/servicedesk/customer/portal/1/article/884670548?source=search"
                                       class="btn btn-outline-primary"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       role="button">
                                        Check configuration documentation
                                    </a>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <div class="o_form_label mb-1">See full range of Ventor Tech Apps</div>
                                    <div class="text-muted mb-2">
                                        Explore the VentorTech ecosystem and discover more applications.
                                    </div>
                                    <a href="https://ecosystem.ventor.tech/"
                                       class="btn btn-outline-primary"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       role="button">
                                        Explore the VentorTech ecosystem
                                    </a>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <div class="o_form_label mb-1">Explore our Configuration Service</div>
                                    <div class="text-muted mb-2">
                                        Don't want to spend time configuring? Let our experts handle the setup for you and get your connector up and running quickly.
                                    </div>
                                    <a href="https://ecosystem.ventor.tech/product/installation-configuration-service/"
                                       class="btn btn-outline-primary"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       role="button">
                                        Purchase or Learn More
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="system_configuration">
                        <h2>System State</h2>
                        <div class="row mt16 o_settings_container" name="system_configuration_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane mb-4">
                                    <div class="text-muted mb-3">
                                        Сlick this button to validate odoo.conf file
                                    </div>
                                    <button name="validate_config_for_quickbooks" string="Validate Configuration File" type="object" class="btn btn-primary"/>
                                </div>

                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="quickbooks_res_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="path">qi-settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_quickbooks_online"/>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'quickbooks_sync_online'}</field>
    </record>

</odoo>
