<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment_method_form_fee_badge" inherit_id="payment.method_form">
        <!-- `provider_fees` is an optional {provider_id: formatted_fee_string} mapping added to
             the rendering context by payment_provider_fee's controllers. Not every payment page
             sets it (only the ones this module overrides), so this must degrade cleanly when
             it's absent. -->
        <xpath expr="//label[@t-out='pm_sudo.name']" position="after">
            <span t-if="provider_fees and provider_fees.get(provider_sudo.id)"
                  t-out="provider_fees[provider_sudo.id]"
                  class="badge text-bg-info o_payment_provider_fee_badge ms-1"
                  title="Payment processing fee"
            />
        </xpath>
    </template>

</odoo>
