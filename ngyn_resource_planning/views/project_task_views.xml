<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_ngyn_resource_planning" model="ir.ui.view">
        <field name="name">project.task.form.inherit.ngyn.resource.planning</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <group string="Resource Planning">
                        <field name="x_ngyn_charged_hours" widget="float_time"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
