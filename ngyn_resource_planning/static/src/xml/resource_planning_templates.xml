<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ngyn_resource_planning.Dashboard" owl="1">
  <div class="o_ngyn_rp">

    <!-- ============ TOP BAR ============ -->
    <div class="o_ngyn_rp_topbar">
      <div class="o_ngyn_rp_brand">Resource Planning</div>
      <div class="o_ngyn_rp_weeknav">
        <button class="o_ngyn_rp_navbtn" t-att-disabled="!canGoPrev" t-on-click="prevWeekBatch">‹</button>
        <button class="o_ngyn_rp_todaybtn" t-on-click="jumpToday">Today</button>
        <span class="o_ngyn_rp_weeklabel" t-esc="weekNavLabel"/>
        <button class="o_ngyn_rp_navbtn" t-att-disabled="!canGoNext" t-on-click="nextWeekBatch">›</button>
      </div>
    </div>

    <div t-if="state.loading" class="o_ngyn_rp_loading">Loading resource plan…</div>

    <div t-else="" class="o_ngyn_rp_workspace">

      <!-- ============ LEFT PANE ============ -->
      <div class="o_ngyn_rp_left">
        <div class="o_ngyn_rp_paneheader">
          <span>Projects</span>
          <span t-esc="filteredProjects.length"/>
        </div>
        <div class="o_ngyn_rp_search">
          <input type="text" placeholder="Search project or client…"
                 t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
        </div>
        <div class="o_ngyn_rp_filters">
          <span t-attf-class="o_chip {{ state.activeFilter === 'all' ? 'active' : '' }}"
                t-on-click="() => this.setFilter('all')">All</span>
          <span t-attf-class="o_chip {{ state.activeFilter === 'red' ? 'active' : '' }}"
                t-on-click="() => this.setFilter('red')">
            Over burn (<t t-esc="healthCounts.red"/>)</span>
          <span t-attf-class="o_chip {{ state.activeFilter === 'amber' ? 'active' : '' }}"
                t-on-click="() => this.setFilter('amber')">
            Stalled (<t t-esc="healthCounts.amber"/>)</span>
          <span t-attf-class="o_chip {{ state.activeFilter === 'green' ? 'active' : '' }}"
                t-on-click="() => this.setFilter('green')">
            On track (<t t-esc="healthCounts.green"/>)</span>
        </div>
        <div class="o_ngyn_rp_sortrow">
          <span>Sort by</span>
          <select t-on-change="onSortChange">
            <option value="health">Health (worst first)</option>
            <option value="deadline">Deadline (soonest)</option>
            <option value="name">Project name</option>
          </select>
        </div>
        <div class="o_ngyn_rp_projectlist">
          <div t-foreach="filteredProjects" t-as="proj" t-key="proj.id"
               t-attf-class="o_proj_row {{ isPinned(proj.id) ? 'pinned' : '' }}"
               t-on-click="() => this.togglePin(proj.id)">
            <div class="o_proj_top">
              <div class="o_proj_text">
                <div class="o_proj_name" t-att-title="proj.name" t-esc="proj.name"/>
                <div class="o_proj_client" t-att-title="proj.client" t-esc="proj.client"/>
              </div>
              <span t-attf-class="o_health_tag {{ projectStats(proj).status }}"
                    t-att-title="healthTip(proj)"
                    t-esc="healthLabel(projectStats(proj).status)"/>
            </div>
            <div class="o_proj_stats">
              <div><span class="k">Due</span>
                   <span class="v" t-esc="fmtDate(proj.dateEnd) + (projectStats(proj).daysLeft !== null ? ' (' + projectStats(proj).daysLeft + 'd)' : '')"/></div>
              <div><span class="k">Charged</span><span class="v" t-esc="proj.charged + 'h'"/></div>
              <div><span class="k">Allocated</span><span class="v" t-esc="projectAllocationStats(proj).allocated + 'h'"/></div>
              <div><span class="k">Unscheduled</span>
                   <span t-attf-class="v {{ projectAllocationStats(proj).unscheduled > 0 ? 'warn' : '' }}"
                         t-esc="projectAllocationStats(proj).unscheduled + 'h'"/></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============ RIGHT PANE ============ -->
      <div class="o_ngyn_rp_right">
        <div t-if="!state.pinned.length" class="o_ngyn_rp_empty">
          Click a project on the left to pin it here for planning. You can pin several at once.
        </div>

        <t t-else="">
          <div class="o_ngyn_rp_toolbar">
            <span><b t-esc="state.pinned.length"/> project(s) pinned</span>
            <div class="o_ngyn_rp_toolbar_btns">
              <button t-on-click="collapseAllProjects">▾ Collapse all projects</button>
              <button t-on-click="expandAllProjects">▸ Expand all projects</button>
            </div>
          </div>

          <div t-foreach="pinnedProjects" t-as="proj" t-key="proj.id"
               t-attf-class="o_pcard {{ isProjectCollapsed(proj.id) ? 'collapsed' : '' }}">

            <div class="o_pcard_head" t-on-click="() => this.toggleProjectCollapse(proj.id)">
              <div class="o_pcard_head_left">
                <button class="o_collapse_btn">▾</button>
                <div class="o_pcard_title_wrap">
                  <div class="o_pcard_title" t-att-title="proj.name" t-esc="proj.name"/>
                  <div class="o_pcard_client" t-esc="proj.client + ' · ' + fmtDate(proj.dateStart) + ' → ' + fmtDate(proj.dateEnd)"/>
                </div>
              </div>
              <div class="o_pcard_head_mid">
                <div class="o_hd_task_toolbar">
                  <button t-on-click="(ev) => { ev.stopPropagation(); this.collapseAllTasks(proj); }">▾ Collapse all tasks</button>
                  <button t-on-click="(ev) => { ev.stopPropagation(); this.expandAllTasks(proj); }">▸ Expand all tasks</button>
                </div>
                <span class="o_hd_stat" t-esc="proj.tasks.length + (proj.tasks.length === 1 ? ' task' : ' tasks')"/>
                <span class="o_hd_stat" t-att-title="statTip('charged')">Charged <b t-esc="projectAllocationStats(proj).charged + 'h'"/></span>
                <span class="o_hd_stat" t-att-title="statTip('allocated')">Allocated <b t-esc="projectAllocationStats(proj).allocated + 'h'"/></span>
                <span class="o_hd_stat" t-att-title="statTip('leftToAssign')">Left to assign
                  <b t-attf-class="{{ projectAllocationStats(proj).leftToAssign &lt; 0 ? 'warn' : '' }}"
                     t-esc="projectAllocationStats(proj).leftToAssign + 'h'"/></span>
                <span class="o_hd_stat" t-att-title="statTip('unscheduled')">Unscheduled
                  <b t-attf-class="{{ projectAllocationStats(proj).unscheduled > 0 ? 'warn' : '' }}"
                     t-esc="projectAllocationStats(proj).unscheduled + 'h'"/></span>
              </div>
              <div class="o_pcard_head_right">
                <span t-attf-class="o_health_pill {{ projectStats(proj).status }}"
                      t-att-title="healthTip(proj)" t-esc="healthLabel(projectStats(proj).status)"/>
                <button class="o_unpin_btn" t-on-click="(ev) => this.unpinProject(proj.id, ev)">✕</button>
              </div>
            </div>

            <div class="o_pcard_body">
              <div t-if="projectOutOfWindow(proj)" class="o_schedule_warning">
                ⚠ This project's schedule (<t t-esc="fmtDate(proj.dateStart)"/> → <t t-esc="fmtDate(proj.dateEnd)"/>)
                is outside the weeks shown — use the week navigator to jump there.
              </div>

              <div class="o_grid_scroll">
                <table class="o_plan_grid">
                  <thead><tr>
                    <th class="task_col">Task / Team member</th>
                    <th t-foreach="visibleWeeks()" t-as="w" t-key="w.idx" class="wk_col" t-esc="w.label"/>
                  </tr></thead>
                  <tbody>
                    <t t-foreach="proj.tasks" t-as="task" t-key="task.id">
                      <tr class="o_task_row" t-on-click="() => this.toggleTaskCollapse(proj.id, task.id)">
                        <td t-attf-colspan="{{ visibleWeeks().length + 1 }}">
                          <div class="o_task_name">
                            <span t-esc="task.name"/>
                            <span class="o_task_charge">
                              charged <t t-esc="task.charged"/>h · allocated <t t-esc="taskComputed(task).allocated"/>h
                              <t t-if="taskComputed(task).unscheduled > 0">
                                · <span class="warn"><t t-esc="taskComputed(task).unscheduled"/>h unscheduled</span>
                              </t>
                            </span>
                          </div>
                        </td>
                      </tr>

                      <t t-if="!isTaskCollapsed(proj.id, task.id)">
                        <tr t-foreach="task.assignments" t-as="a" t-key="a.id" class="o_emp_row">
                          <td class="emp_cell">
                            <div class="o_emp_inner">
                              <div class="o_avatar" t-attf-style="background:{{ avatarColor(a.employeeId) }}"
                                   t-esc="initials(a.employeeName)"/>
                              <div class="o_emp_text">
                                <span class="name" t-esc="a.employeeName"/>
                              </div>
                              <button class="o_pin_btn" t-att-class="isEmployeePinned(a.employeeId) ? 'active' : ''"
                                      t-on-click="(ev) => this.toggleEmployeePin(a.employeeId, ev)"
                                      title="Pin / unpin from weekly load filter">📌</button>
                              <input type="number" step="0.25" min="0" class="o_alloc_input"
                                     t-att-value="a.alloc" t-on-change="(ev) => this.onAllocChange(a, ev)"/>
                            </div>
                          </td>
                          <td t-foreach="visibleWeeks()" t-as="w" t-key="w.idx" class="wk_cell">
                            <div t-if="!inSchedule(proj, w.idx)" class="o_dim_box locked" title="Outside project schedule">
                              <span class="out">✕</span>
                            </div>
                            <div t-elif="isPastWeek(w.idx)" class="o_dim_box locked"
                                 title="Actual hours logged this week — past weeks aren't editable here.">
                              <span class="actual" t-esc="actualHours(a, w.idx) > 0 ? actualHours(a, w.idx) + 'h' : '–'"/>
                            </div>
                            <div t-else="" class="o_dim_box">
                              <input type="number" step="0.25" min="0"
                                     t-att-value="displayHours(weekHours(a, w.idx))"
                                     t-on-change="(ev) => this.onWeekChange(a, w.idx, ev)"/>
                            </div>
                          </td>
                        </tr>

                        <tr class="o_add_row">
                          <td t-attf-colspan="{{ visibleWeeks().length + 1 }}">
                            <button class="o_add_emp_btn" t-on-click="(ev) => this.toggleAddMember(task, ev)">+ Add team member</button>
                            <div t-if="isPickerOpen(task.id)" class="o_emp_picker">
                              <div class="o_picker_role_col">
                                <div t-attf-class="o_role_chip {{ state.pickerRoleFilter === 'all' ? 'active' : '' }}"
                                     t-on-click="(ev) => this.setPickerRole('all', ev)">All</div>
                                <div t-foreach="roles" t-as="r" t-key="r"
                                     t-attf-class="o_role_chip {{ state.pickerRoleFilter === r ? 'active' : '' }}"
                                     t-on-click="(ev) => this.setPickerRole(r, ev)" t-esc="r"/>
                              </div>
                              <div class="o_picker_member_col">
                                <div t-if="!pickerMembers().length" class="o_picker_empty">No one with this role.</div>
                                <div t-foreach="pickerMembers()" t-as="e" t-key="e.id" class="o_member_chip"
                                     t-on-click="(ev) => this.addAssignment(task, e, ev)">
                                  <div class="o_avatar xs" t-attf-style="background:{{ avatarColor(e.id) }}" t-esc="initials(e.name)"/>
                                  <span class="n" t-esc="e.name"/>
                                  <span class="r" t-esc="e.role"/>
                                </div>
                              </div>
                            </div>
                          </td>
                        </tr>
                      </t>
                    </t>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </t>
      </div>
    </div>

    <!-- ============ WEEKLY LOAD STRIP ============ -->
    <div t-if="!state.loading" t-attf-class="o_capstrip {{ state.capCollapsed ? 'collapsed' : '' }}">
      <div class="o_cap_header" t-on-click="toggleCapCollapsed">
        <div class="o_cap_header_left">
          <button class="o_collapse_btn">▾</button>
          <span>Weekly load</span>
        </div>
        <div class="o_cap_legend">
          <span title="Within the 70% planning buffer"><i class="green"/>within buffer</span>
          <span title="Past the buffer, within full capacity"><i class="amber"/>using buffer</span>
          <span title="Over full weekly capacity"><i class="red"/>over capacity</span>
        </div>
      </div>
      <div class="o_cap_subheader">
        <input type="text" placeholder="Search team member…" t-on-input="onCapSearchInput"/>
        <div class="o_cap_role_chips">
          <span t-attf-class="o_role_chip small {{ state.capRoleFilter === 'all' ? 'active' : '' }}"
                t-on-click="() => this.setCapRoleFilter('all')">All roles</span>
          <span t-foreach="roles" t-as="r" t-key="r"
                t-attf-class="o_role_chip small {{ state.capRoleFilter === r ? 'active' : '' }}"
                t-on-click="() => this.setCapRoleFilter(r)" t-esc="r"/>
        </div>
      </div>
      <div class="o_grid_scroll">
        <table class="o_cap_grid">
          <thead><tr>
            <th class="name_col">Team member</th>
            <th t-foreach="visibleWeeks()" t-as="w" t-key="w.idx" class="wk_col" t-esc="w.label"/>
          </tr></thead>
          <tbody>
            <tr t-foreach="filteredCapEmployees" t-as="emp" t-key="emp.id">
              <td class="name_col">
                <div class="o_cap_name_inner">
                  <div class="o_avatar xs" t-attf-style="background:{{ avatarColor(emp.id) }}" t-esc="initials(emp.name)"/>
                  <div class="o_cap_name_txt">
                    <span class="n" t-esc="emp.name"/>
                    <span class="r" t-esc="emp.role + ' · target ' + emp.target + 'h/wk'"/>
                  </div>
                  <button class="o_pin_btn" t-att-class="isEmployeePinned(emp.id) ? 'active' : ''"
                          t-on-click="(ev) => this.toggleEmployeePin(emp.id, ev)"
                          title="Pin / unpin from weekly load filter">📌</button>
                </div>
              </td>
              <td t-foreach="visibleWeeks()" t-as="w" t-key="w.idx">
                <t t-set="isPast" t-value="isPastWeek(w.idx)"/>
                <t t-set="total" t-value="weekTotalForEmployee(emp.id, w.idx, isPast)"/>
                <div t-if="total === 0" class="o_load_empty">–</div>
                <div t-elif="isPast" class="o_load_cell past" t-att-title="pastLoadTip()">
                  <span class="alloc" t-esc="total + 'h'"/><span class="sub">actual</span>
                </div>
                <div t-else="" t-attf-class="o_load_cell {{ capCellTier(total, emp) }}" t-att-title="capCellTip(total, emp)">
                  <span class="alloc" t-esc="total + 'h'"/>
                  <span class="sub" t-esc="(emp.target - total) >= 0 ? 'free ' + (emp.target - total) + 'h' : 'over ' + Math.abs(emp.target - total) + 'h'"/>
                </div>
              </td>
            </tr>
            <tr t-if="!filteredCapEmployees.length">
              <td t-attf-colspan="{{ visibleWeeks().length + 1 }}" class="o_cap_empty_row" t-esc="capEmptyReason()"/>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="o_footnote">Grey cells = past weeks, showing actual logged hours (not editable). Colored cells = planned. Hover a cell for exact numbers.</div>
    </div>

  </div>
</t>

</templates>
